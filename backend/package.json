{
  "name": "lobbyup-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lobbyup — online quiz/examination backend (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "loadtest:seed": "tsx --env-file-if-exists=.env loadtest/seed-loadtest.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/security",
    "test:watch": "vitest",
    "dev:worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "db:roles": "tsx --env-file-if-exists=.env scripts/db-roles.ts",
    "db:backup": "sh scripts/backup-db.sh",
    "db:restore": "sh scripts/restore-db.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
