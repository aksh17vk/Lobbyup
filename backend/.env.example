# ─── Lobbyup backend configuration ───
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the app (Render/Koyeb/Fly: 1). 0 locally.
TRUST_PROXY=0

# Postgres. On Neon/Supabase use the *pooled* URL here (add ?pgbouncer=true when using
# a transaction pooler) and the direct URL in DIRECT_DATABASE_URL (used for migrations).
# connection_limit caps Prisma's pool per instance — keep it below your plan's limit.
DATABASE_URL=postgresql://lobbyup:lobbyup@localhost:5432/lobbyup?connection_limit=20
DIRECT_DATABASE_URL=postgresql://lobbyup:lobbyup@localhost:5432/lobbyup

# Redis (Upstash: rediss://default:<password>@<host>:6379)
REDIS_URL=redis://localhost:6379
# Per-command timeout; on timeout the Postgres fallbacks take over.
REDIS_COMMAND_TIMEOUT_MS=1000

# Comma-separated list of allowed browser origins (your Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Auth cookie. In production keep COOKIE_SECURE=true. If the frontend is on a different
# site than the API, either proxy /api through Next.js (recommended, keeps SameSite=lax)
# or use COOKIE_SAMESITE=none.
SESSION_COOKIE_NAME=lobbyup_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
AUTH_RETURN_TOKEN=false
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Concurrent password hashes (keep <= vCPUs) and how many logins may queue before a retryable 503.
ARGON2_MAX_CONCURRENCY=2
ARGON2_MAX_QUEUE=500

# Exam behaviour
SUBMIT_GRACE_SECONDS=30
EXAM_SESSION_TAKEOVER=allow
# redis = buffer autosaves in Redis and flush in batches; direct = write every autosave to Postgres
# (use direct when your Redis plan has a tight command quota).
ANSWER_BUFFER=redis
MAX_EVENTS_PER_ATTEMPT=3000

# Background workers (run in-process by default)
WORKERS_ENABLED=true
ANSWER_FLUSH_INTERVAL_MS=2000
EXPIRY_SWEEP_INTERVAL_MS=15000

# Privacy retention (days; 0 disables). See docs/PRIVACY.md
DATA_RETENTION_DAYS=180
SESSION_RETENTION_DAYS=30

RATE_LIMIT_ENABLED=true
# Must exceed the number of students logging in together from one NAT/public IP.
LOGIN_RATE_LIMIT_PER_IP=1500

# Least-privilege app role (pnpm db:roles, run with the OWNER url in DIRECT_DATABASE_URL).
# In production point DATABASE_URL at this role and keep the owner URL for migrations only.
# APP_DB_USER=lobbyup_app
# APP_DB_PASSWORD=

# Backups (pnpm db:backup / db:restore) — see docs/DATABASE.md
# BACKUP_DATABASE_URL=
# BACKUP_DIR=./backups
# BACKUP_GPG_RECIPIENT=
# BACKUP_RETENTION_DAYS=14

# Only for local production-mode testing with the docker-compose credentials. Never in a real deployment.
# ALLOW_DEV_CREDENTIALS=false

# Seed (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@lobbyup.local
SEED_ADMIN_PASSWORD=change-me-to-a-long-password
SEED_DEMO=false
